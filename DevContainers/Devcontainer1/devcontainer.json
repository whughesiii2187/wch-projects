{
  "name": "Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },

  "remoteUser": "dev",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",

  // Podman-specific: rootless, no privileged needed
  "runArgs": [
    "--userns=keep-id",
    "--security-opt=label=disable"
  ],

  "containerEnv": {
    "GOPATH": "/home/dev/go",
    "GOBIN": "/home/dev/go/bin",
    "ODIN_ROOT": "/opt/odin",
    "DATABASE_URL": "postgres://dev:dev@localhost:5432/devdb?sslmode=disable"
  },

  "forwardPorts": [5432],
  "portsAttributes": {
    "5432": { "label": "Postgres", "onAutoForward": "silent" }
  }
}
