{
  "name": "Python",
  "image": "mcr.microsoft.com/devcontainers/python:3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/stuartleeks/dev-container-features/shell-history:0": {}
  },
  "initializeCommand": {
    "ensure-claude-dir": "mkdir -p \"${localEnv:HOME}${localEnv:USERPROFILE}/.claude\""
  },
  "onCreateCommand": {
    "git-safe": "git config --global --add safe.directory ${containerWorkspaceFolder}"
  },
  "postCreateCommand": {
    "uv": "pip install uv",
    "uv-sync": "uv sync 2>/dev/null || true"
  },
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude,type=bind"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "always"
          }
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "eamodio.gitlens"
      ]
    }
  }
}
